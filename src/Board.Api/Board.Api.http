###############################################################################
# Board API — Coleção de testes (.http)
#
# Cobre TODAS as entidades e rotas: Health, Users, Auth, Projects e Comments.
# Abre nativo no Rider/Visual Studio e no VS Code (extensão "REST Client").
#
# -------------------------- COMO USAR -----------------------------------------
# 1. Suba o banco e a API (ver README / CLAUDE.md):
#      docker compose up -d database
#      ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=board;Username=postgres;Password=postgres" \
#        dotnet run --project src/Board.Api
# 2. Rode as requisições de cima para baixo (clique em "Send Request" / ▶).
# 3. Algumas requisições devolvem IDs/token que você COLA nas variáveis @ abaixo.
#    Cada bloco indica de onde copiar o valor.
#
# OBS: ainda não existe endpoint para criar Card (é de outra pessoa do grupo).
#      Para testar Comments, semeie um Card via SQL (ver bloco "SEED DO CARD").
###############################################################################

@host = http://localhost:5201

# >>> Preencha conforme for executando as requisições <<<
@token = COLE_AQUI_O_TOKEN_DO_LOGIN
@ownerId = COLE_AQUI_O_ID_DO_USUARIO
@cardId = 33333333-3333-3333-3333-333333333333
@commentId = COLE_AQUI_O_ID_DE_UM_COMENTARIO


###############################################################################
# 0) HEALTH CHECK  (público)
###############################################################################

### Status da API + conexão com o Postgres
GET {{host}}/


###############################################################################
# 1) USERS
###############################################################################

### 1.1 Registrar usuário (público)
# Senha: 8+ chars, ao menos 1 número e 1 caractere especial. Ex.: senha@123
POST {{host}}/api/users
Content-Type: application/json

{
  "name": "Alice",
  "email": "alice@test.com",
  "password": "senha@123"
}

### 1.2 Registrar um segundo usuário (público) — útil para filtrar por autor
POST {{host}}/api/users
Content-Type: application/json

{
  "name": "Bob",
  "email": "bob@test.com",
  "password": "senha@123"
}

### 1.3 Listar usuários (protegido) — copie o "id" da Alice para @ownerId
GET {{host}}/api/users
Authorization: Bearer {{token}}

### 1.4 Buscar usuário por id (protegido)
GET {{host}}/api/users/{{ownerId}}
Authorization: Bearer {{token}}


###############################################################################
# 2) AUTH
###############################################################################

### 2.1 Login (público) — copie o "token" da resposta para a variável @token
# A senha é case-sensitive e deve ser idêntica à do registro.
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "alice@test.com",
  "password": "senha@123"
}

### 2.2 Dados do usuário autenticado (protegido)
GET {{host}}/api/auth/me
Authorization: Bearer {{token}}

### 2.3 (negativo) Acessar rota protegida sem token  ->  401 Unauthorized
GET {{host}}/api/auth/me


###############################################################################
# 3) PROJECTS
###############################################################################

### 3.1 Criar projeto (protegido)
# ownerId deve ser um usuário existente (use o id da Alice).
# color: hexadecimal #RRGGBB. Cria automaticamente 3 colunas padrão.
POST {{host}}/api/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ownerId": "{{ownerId}}",
  "name": "Projeto de Teste",
  "description": "Quadro de exemplo",
  "color": "#3498DB"
}

### 3.2 (negativo) Cor em formato inválido  ->  400 Bad Request
POST {{host}}/api/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ownerId": "{{ownerId}}",
  "name": "Projeto Cor Inválida",
  "description": null,
  "color": "azul"
}


###############################################################################
# SEED DO CARD (necessário para testar Comments enquanto não há endpoint de Card)
#
# Rode no terminal, com o id da Alice no owner_id (ou rode o INSERT de users antes):
#
#   docker compose exec -T database psql -U postgres -d board <<'SQL'
#   INSERT INTO projects (id, owner_id, name, color, is_active, created_at)
#   VALUES ('11111111-1111-1111-1111-111111111111', (SELECT id FROM users ORDER BY created_at LIMIT 1), 'Projeto Seed', '#3498db', true, now()) ON CONFLICT (id) DO NOTHING;
#   INSERT INTO columns (id, project_id, name, sort_order, created_at)
#   VALUES ('22222222-2222-2222-2222-222222222222', '11111111-1111-1111-1111-111111111111', 'A Fazer', 0, now()) ON CONFLICT (id) DO NOTHING;
#   INSERT INTO cards (id, column_id, assignee_id, title, description, sort_order, due_date, priority, updated_at, created_at)
#   VALUES ('33333333-3333-3333-3333-333333333333', '22222222-2222-2222-2222-222222222222', NULL, 'Card de Teste', NULL, 0, NULL, 'None', now(), now()) ON CONFLICT (id) DO NOTHING;
#   SQL
#
# O @cardId já aponta para 33333333-3333-3333-3333-333333333333.
###############################################################################


###############################################################################
# 4) COMMENTS  (rota aninhada em /api/cards/{cardId}/comments — tudo protegido)
###############################################################################

### 4.1 Criar comentário (protegido) — autor vem do token
# Copie o "id" da resposta para a variável @commentId.
POST {{host}}/api/cards/{{cardId}}/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "Preciso revisar o deploy urgente"
}

### 4.2 Listar comentários do card (protegido) — SEM filtro
GET {{host}}/api/cards/{{cardId}}/comments
Authorization: Bearer {{token}}

### 4.3 Filtrar por autor (protegido)  [requer PR feat/comment-filters]
GET {{host}}/api/cards/{{cardId}}/comments?authorId={{ownerId}}
Authorization: Bearer {{token}}

### 4.4 Buscar por texto no conteúdo, case-insensitive (protegido)  [requer PR feat/comment-filters]
GET {{host}}/api/cards/{{cardId}}/comments?search=deploy
Authorization: Bearer {{token}}

### 4.5 Filtros combinados: autor + busca (protegido)  [requer PR feat/comment-filters]
GET {{host}}/api/cards/{{cardId}}/comments?authorId={{ownerId}}&search=deploy
Authorization: Bearer {{token}}

### 4.6 Editar comentário (protegido) — só o autor pode; senão 403
PUT {{host}}/api/cards/{{cardId}}/comments/{{commentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "Comentário editado"
}

### 4.7 (negativo) Listar sem token  ->  401 Unauthorized
GET {{host}}/api/cards/{{cardId}}/comments

### 4.8 Excluir comentário (protegido) — só o autor pode; retorna 204 No Content
DELETE {{host}}/api/cards/{{cardId}}/comments/{{commentId}}
Authorization: Bearer {{token}}

###